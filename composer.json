{
    "name": "laravolt/metabase",
    "description": "Embed Metabase dashboard and question in your application",
    "keywords": [
        "laravolt",
        "laravel",
        "metabase"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bayu Hendra Winata",
            "email": "uyab.exe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "12.*",
        "lcobucci/jwt": "^4.1|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Laravolt\\Metabase\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravolt\\Metabase\\MetabaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "phpstan-baseline": "phpstan analyse --generate-baseline --memory-limit=1G",
        "phpstan-clear": "phpstan clear-result-cache",
        "test-static": "@phpstan",
        "analyse": "@phpstan",
        "check": [
            "@phpstan"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.7"
    }
}
