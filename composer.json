{
    "name": "laravolt/metabase",
    "description": "Embed Metabase dashboard and question in your application",
    "keywords": [
        "laravolt",
        "laravel",
        "metabase"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bayu Hendra Winata",
            "email": "uyab.exe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.68|^13.29",
        "firebase/php-jwt": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Laravolt\\Metabase\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravolt\\Metabase\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravolt\\Metabase\\MetabaseServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5|^13.4"
    }
}
